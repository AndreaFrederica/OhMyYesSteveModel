#version 430 core
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer Source { float source[]; };
layout(std430,binding=1) readonly buffer Structure { int structure[]; };
layout(std430,binding=2) readonly buffer Influences { float weights[]; };
layout(std430,binding=3) readonly buffer Frame { float frame[]; };
layout(std430,binding=4) writeonly buffer Output { float outputData[]; };
layout(std430,binding=5) buffer Status { int invalid; };
uniform int VertexCount,BoneCount,JointsStart,ModesStart,MorphRangesStart,MorphEntriesStart;

vec4 quaternion(mat4 m) {
    float trace=m[0][0]+m[1][1]+m[2][2];vec4 q;
    if(trace>0){float s=sqrt(trace+1)*2;q=vec4((m[1][2]-m[2][1])/s,(m[2][0]-m[0][2])/s,(m[0][1]-m[1][0])/s,s/4);}
    else {int a=m[0][0]>m[1][1]?0:1;if(m[2][2]>m[a][a])a=2;int b=(a+1)%3,c=(a+2)%3;float s=sqrt(1+m[a][a]-m[b][b]-m[c][c])*2;
        q=vec4(0);q[a]=s/4;q[b]=(m[a][b]+m[b][a])/s;q[c]=(m[a][c]+m[c][a])/s;q.w=(m[b][c]-m[c][b])/s;}
    return normalize(q);
}
vec4 multiplyQ(vec4 a,vec4 b){return vec4(a.w*b.xyz+b.w*a.xyz+cross(a.xyz,b.xyz),a.w*b.w-dot(a.xyz,b.xyz));}
mat4 rotationMatrix(vec4 q,vec3 t){q=normalize(q);float x=q.x,y=q.y,z=q.z,w=q.w;
    return mat4(vec4(1-2*y*y-2*z*z,2*x*y+2*z*w,2*x*z-2*y*w,0),vec4(2*x*y-2*z*w,1-2*x*x-2*z*z,2*y*z+2*x*w,0),
        vec4(2*x*z+2*y*w,2*y*z-2*x*w,1-2*x*x-2*y*y,0),vec4(t,1));}
mat4 bone(int id){if(id<0)return mat4(1);int p=id*16;return mat4(vec4(frame[p],frame[p+1],frame[p+2],frame[p+3]),
    vec4(frame[p+4],frame[p+5],frame[p+6],frame[p+7]),vec4(frame[p+8],frame[p+9],frame[p+10],frame[p+11]),vec4(frame[p+12],frame[p+13],frame[p+14],frame[p+15]));}
vec4 slerpQ(vec4 a,vec4 b,float t){float d=dot(a,b);if(d<0){b=-b;d=-d;}if(d>=.9995)return normalize(mix(a,b,t));float angle=acos(min(1,d));return normalize((sin((1-t)*angle)*a+sin(t*angle)*b)/sin(angle));}
vec3 unit(vec3 v){float n=length(v);return n<1e-30?vec3(0):v/n;}
bool rigid(mat4 m){mat3 r=mat3(m);for(int c=0;c<3;c++)for(int d=0;d<3;d++)if(abs(dot(r[c],r[d])-(c==d?1:0))>.002)return false;return determinant(r)>=0;}
void main(){
    int v=int(gl_GlobalInvocationID.x);if(v>=VertexCount)return;
    float data[17];for(int k=0;k<17;k++)data[k]=source[v*26+k];
    int mb=structure[MorphRangesStart+v],me=structure[MorphRangesStart+v+1];
    for(int i=mb;i<me;i++){int p=MorphEntriesStart+i*3;data[structure[p+1]]+=frame[BoneCount*16+structure[p]]*intBitsToFloat(structure[p+2]);}
    int begin=structure[v],end=structure[v+1],mode=structure[ModesStart+v];mat4 m=mat4(0);vec3 pos=vec3(data[0],data[1],data[2]);
    if(mode==1){int a=structure[JointsStart+begin],b=structure[JointsStart+begin+1];mat4 m0=bone(a),m1=bone(b);
        if(!rigid(m0)||!rigid(m1)){atomicOr(invalid,1);return;}vec4 q=slerpQ(quaternion(m0),quaternion(m1),weights[begin+1]);m=rotationMatrix(q,vec3(0));
        int p=v*26+17;vec3 c=vec3(source[p],source[p+1],source[p+2]),r0=vec3(source[p+3],source[p+4],source[p+5]),r1=vec3(source[p+6],source[p+7],source[p+8]);
        vec3 rw=r0*weights[begin]+r1*weights[begin+1];pos=mat3(m)*(pos-c)+(m0*vec4(c+(r0-rw)*.5,1)).xyz*weights[begin]+(m1*vec4(c+(r1-rw)*.5,1)).xyz*weights[begin+1];
    }else if(mode==2){vec4 real=vec4(0),dual=vec4(0),reference=vec4(0);bool found=false;
        for(int i=begin;i<end;i++){float w=weights[i];if(w==0)continue;mat4 b=bone(structure[JointsStart+i]);if(!rigid(b)){atomicOr(invalid,1);return;}
            vec4 q=quaternion(b),d=multiplyQ(vec4(b[3].xyz,0),q);if(!found){reference=q;found=true;}if(dot(reference,q)<0)w=-w;real+=q*w;dual+=d*(.5*w);}
        float n=length(real);if(n<1e-12){atomicOr(invalid,1);return;}real/=n;dual/=n;dual-=real*dot(real,dual);vec4 t=multiplyQ(dual,vec4(-real.xyz,real.w));m=rotationMatrix(real,t.xyz*2);pos=(m*vec4(pos,1)).xyz;
    }else{for(int i=begin;i<end;i++){float w=weights[i];if(w!=0)m+=bone(structure[JointsStart+i])*w;}m[3][3]=1;pos=(m*vec4(pos,1)).xyz;}
    vec3 normal=unit(mat3(m)*vec3(data[3],data[4],data[5]));vec3 tangent=mat3(m)*vec3(data[6],data[7],data[8]);tangent=unit(tangent-normal*dot(normal,tangent));
    data[0]=pos.x;data[1]=pos.y;data[2]=pos.z;data[3]=normal.x;data[4]=normal.y;data[5]=normal.z;data[6]=tangent.x;data[7]=tangent.y;data[8]=tangent.z;if(determinant(mat3(m))<0)data[9]=-data[9];
    for(int k=0;k<17;k++){if(isnan(data[k])||isinf(data[k])){atomicOr(invalid,1);return;}outputData[v*17+k]=data[k];}
}
