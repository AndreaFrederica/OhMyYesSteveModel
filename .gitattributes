# Disable autocrlf on generated files, they always generate with LF
# Add any extra files or paths here to make git stop saying they
# are changed when only line endings change.
src/generated/**/.cache/cache text eol=lf
src/generated/**/*.json text eol=lf

# Preserve whitespace in unmodified upstream source and license snapshots.
runtime/concentus/src/main/java/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
runtime/forge/src/main/resources/licenses/** whitespace=-blank-at-eol,-blank-at-eof

# Frozen reference assets and licensed source snapshots retain exact bytes/hashes.
runtime/*/src/test/resources/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
src/test/resources/*-oracle/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
runtime/forge/src/main/resources/licenses/** -text
runtime/native/src/math/** -text
runtime/native/src/math/source.json text eol=lf
